                    {policy["text"].replace(chr(10), "<br>")}
                </div>

            </div>
            """,
            unsafe_allow_html=True,
        )

    # --------------------------------------------------------
    # AI DEFENSE
    # --------------------------------------------------------

    st.markdown(
        '<div class="section-title">AI Defense Response</div>',
        unsafe_allow_html=True,
