    # --------------------------------------------------------

    if recommendation == "STRONG_DEFENSE":

        status_class = "status-strong"

    elif recommendation == "REVIEW":

        status_class = "status-review"

    else:

        status_class = "status-insufficient"

    st.markdown(
        f"""
        <div style="margin-top:18px;">
            <span class="{status_class}">
